<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SOCYVIA.App"
             xmlns:local="using:SOCYVIA"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://SOCYVIA/Styles/SocyviaTheme.axaml"/>
    </Application.Styles>

</Application>