<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:SOCYVIA.Views"
             x:Class="SOCYVIA.Views.LoginView"
             x:Name="RootLogin"
             FontFamily="{StaticResource EnglishFont}">
  <UserControl.Styles>
    <Style Selector="Button.modeOption">
      <Setter Property="Height" Value="40"/>
      <Setter Property="Width" Value="150"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource SocyviaSecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.modeOption:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceInteractive}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.modeOption.selected">
      <Setter Property="Background" Value="{StaticResource PrimarySoft}"/>
      <Setter Property="Foreground" Value="{StaticResource Primary}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderBrush" Value="{StaticResource StrokeFocus}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </UserControl.Styles>
  <Grid>
    <views:AtmosphericBackground/>
    <Grid Margin="26" ColumnDefinitions="384,*" ColumnSpacing="24">
      <Border Grid.Column="0" Classes="glassElevated" Padding="36,30">
        <Grid RowDefinitions="*,Auto,*">
          <!-- One physical brand geometry is shared by Arabic and English. Text can
               wrap inside its reserved row without shifting the accent or language row. -->
          <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                RowDefinitions="66,13,34,13,40,13,45,13,34">
            <Image Source="avares://SOCYVIA/Assets/Branding/socyvia-mark.png"
                   Width="66" Height="66" Stretch="Uniform" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="SOCYVIA" FontSize="28" FontWeight="Bold" LetterSpacing="4.8"
                       Foreground="{StaticResource SocyviaInkBrush}" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="4" x:Name="BrandSubtitleText" MaxWidth="330"
                       FontSize="12.5" LineHeight="20"
                       Foreground="{StaticResource SocyviaSecondaryTextBrush}"
                       TextAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Grid Grid.Row="6" RowDefinitions="34,9,2" HorizontalAlignment="Center">
              <TextBlock x:Name="HeroLine1Text" MaxWidth="340" FontSize="11.5" LineHeight="17"
                         Foreground="{StaticResource SocyviaAccentBrush}" TextAlignment="Center"
                         TextWrapping="Wrap" VerticalAlignment="Center"/>
              <Border Grid.Row="2" x:Name="HeroAccentLine" Width="52" Height="2" HorizontalAlignment="Center"
                      Background="{StaticResource SocyviaAccentBrush}" CornerRadius="1"/>
              <TextBlock x:Name="HeroLine2Text" IsVisible="False"/>
              <TextBlock x:Name="LoginDescriptionText" IsVisible="False"/>
            </Grid>

            <StackPanel Grid.Row="7" x:Name="FeaturesPanel" IsVisible="False" Spacing="7" HorizontalAlignment="Center">
              <StackPanel x:Name="FeatureResearchDesignRow" Orientation="Horizontal" Spacing="9">
                <Ellipse Width="6" Height="6" Fill="{StaticResource SocyviaAccentBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="FeatureResearchDesignText" FontSize="8.6" Foreground="{StaticResource SocyviaSecondaryTextBrush}"/>
              </StackPanel>
              <StackPanel x:Name="FeatureDigitalInteractionRow" Orientation="Horizontal" Spacing="9">
                <Ellipse Width="6" Height="6" Fill="#6685A8" VerticalAlignment="Center"/>
                <TextBlock x:Name="FeatureDigitalInteractionText" FontSize="8.6" Foreground="{StaticResource SocyviaSecondaryTextBrush}"/>
              </StackPanel>
              <StackPanel x:Name="FeatureAnalysisRow" Orientation="Horizontal" Spacing="9">
                <Ellipse Width="6" Height="6" Fill="#8B98A8" VerticalAlignment="Center"/>
                <TextBlock x:Name="FeatureAnalysisText" FontSize="8.6" Foreground="{StaticResource SocyviaSecondaryTextBrush}"/>
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="8" x:Name="LanguageContentPanel" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
              <TextBlock x:Name="LanguageLabelText" FontSize="11" Foreground="{StaticResource SocyviaMutedTextBrush}" VerticalAlignment="Center"/>
              <Button x:Name="EnglishLanguageButton" Classes="quiet" Padding="6,3">
                <StackPanel Spacing="3"><TextBlock x:Name="EnglishLanguageText" TextAlignment="Center"/><Border x:Name="EnglishUnderline" Width="36" Height="2" Background="{StaticResource SocyviaAccentBrush}" CornerRadius="1"/></StackPanel>
              </Button>
              <Button x:Name="ArabicLanguageButton" Classes="quiet" Padding="6,3">
                <StackPanel Spacing="3"><TextBlock x:Name="ArabicLanguageText" TextAlignment="Center"/><Border x:Name="ArabicUnderline" Width="36" Height="2" Background="{StaticResource SocyviaAccentBrush}" CornerRadius="1" Opacity="0"/></StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1" x:Name="ResearcherWorkspaceCard" Classes="glassElevated" Padding="32,26"
              VerticalAlignment="Stretch">
        <!-- Stable shared geometry: no language or mode can move the consent/action region. -->
        <Grid x:Name="ResearcherWorkspaceForm"
              RowDefinitions="54,10,40,10,82,10,60,10,60,*,44,10,40">
          <StackPanel Grid.Row="0" Spacing="4">
            <Border x:Name="CardAccentLine" Width="36" Height="3" HorizontalAlignment="Center"
                    Background="{StaticResource SocyviaAccentBrush}" CornerRadius="2"/>
            <TextBlock x:Name="ResearcherAccessTitleText" Margin="0,8,0,0"
                       FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SocyviaInkBrush}" TextAlignment="Center"/>
            <TextBlock x:Name="ResearcherAccessSubtitleText" FontSize="11.5"
                       MaxWidth="370" Foreground="{StaticResource SocyviaSecondaryTextBrush}"
                       TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>

          <Grid Grid.Row="2" x:Name="ResearcherModePanel" ColumnDefinitions="Auto,14,Auto"
                HorizontalAlignment="Center">
              <Button x:Name="ExistingModeButton" Classes="modeOption"><TextBlock x:Name="ExistingModeText" TextAlignment="Center"/></Button>
              <Button x:Name="NewModeButton" Grid.Column="2" Classes="modeOption"><TextBlock x:Name="NewModeText" TextAlignment="Center"/></Button>
          </Grid>

          <Grid Grid.Row="4" Height="82">
            <Grid x:Name="ExistingResearcherPanel" RowDefinitions="14,40,18" RowSpacing="5">
              <TextBlock x:Name="SavedResearcherLabel" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource SocyviaTextBrush}" TextAlignment="Center"/>
              <ComboBox x:Name="ResearcherProfileComboBox" Grid.Row="1" HorizontalAlignment="Stretch"/>
              <Button x:Name="ClearSavedResearchersButton" Grid.Row="2" Classes="quiet" HorizontalAlignment="Center" Height="18" Padding="8,0"><TextBlock x:Name="ClearSavedResearchersText" FontSize="7.8" TextAlignment="Center"/></Button>
            </Grid>
            <Grid x:Name="NewResearcherPanel" IsVisible="False" Height="60" VerticalAlignment="Top" RowDefinitions="14,40" RowSpacing="6">
              <TextBlock x:Name="ResearcherNameLabelText" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource SocyviaTextBrush}"/>
              <TextBox x:Name="ResearcherNameBox" Grid.Row="1" VerticalContentAlignment="Center"/>
            </Grid>
          </Grid>

          <Grid Grid.Row="6" RowDefinitions="14,40" RowSpacing="6">
            <Grid x:Name="PasswordHeader" ColumnDefinitions="*,Auto">
              <TextBlock x:Name="PasswordLabelText" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource SocyviaTextBrush}"/>
              <TextBlock x:Name="OptionalText" Grid.Column="1" FontSize="10.5" Foreground="{StaticResource SocyviaMutedTextBrush}"/>
            </Grid>
            <Grid x:Name="PasswordInputContainer" Grid.Row="1">
              <TextBox x:Name="PasswordBox" PasswordChar="●" VerticalContentAlignment="Center" Padding="12,7,44,7"/>
              <TextBlock x:Name="PasswordPlaceholderText" Margin="13,0,44,0" VerticalAlignment="Center" Foreground="{StaticResource SocyviaDisabledTextBrush}" IsHitTestVisible="False"/>
              <Border x:Name="TogglePasswordButton" Width="40" HorizontalAlignment="Right" Background="Transparent" Cursor="Hand">
                <Viewbox Width="17" Height="17"><Canvas Width="24" Height="16"><Path x:Name="PasswordEyeIcon" Fill="Transparent" Stroke="#718097" StrokeThickness="1.6" Data="M1,8 C4,3 8,2 12,2 C16,2 20,3 23,8 C20,13 16,14 12,14 C8,14 4,13 1,8 Z M12,5 C13.7,5 15,6.3 15,8 C15,9.7 13.7,11 12,11 C10.3,11 9,9.7 9,8 C9,6.3 10.3,5 12,5 Z"/></Canvas></Viewbox>
              </Border>
            </Grid>
          </Grid>

          <Grid Grid.Row="8">
            <Grid x:Name="ConfirmPasswordPanel" RowDefinitions="14,40" RowSpacing="6">
              <TextBlock x:Name="ConfirmPasswordLabelText" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource SocyviaTextBrush}"/>
              <TextBox x:Name="ConfirmPasswordBox" Grid.Row="1" PasswordChar="●" VerticalContentAlignment="Center"/>
            </Grid>
          </Grid>

          <Grid Grid.Row="10" RowDefinitions="18,18" RowSpacing="8">
            <CheckBox x:Name="RememberMeCheckBox" VerticalAlignment="Center" FontSize="11"><TextBlock x:Name="RememberMeText" TextWrapping="NoWrap"/></CheckBox>
            <CheckBox Grid.Row="1" x:Name="PrivacyCheckBox" VerticalAlignment="Center" FontSize="10.5"><TextBlock x:Name="PrivacyText" TextWrapping="NoWrap"/></CheckBox>
          </Grid>
          <Grid Grid.Row="12">
            <Button x:Name="EnterWorkspaceButton" Classes="primary" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><TextBlock x:Name="EnterWorkspaceText" TextAlignment="Center"/></Button>
          </Grid>
          <TextBlock Grid.Row="9" x:Name="LoginErrorText" IsVisible="False" VerticalAlignment="Center"
                     FontSize="10.5" Foreground="{StaticResource SocyviaErrorBrush}" TextWrapping="Wrap"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
