<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SOCYVIA.Views.ParticipantExperimentView"
             x:Name="ParticipantRoot"
             Background="#F1F4F8">
    <UserControl.Styles>
        <Style Selector="Button.participantPrimary">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="22,9"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.participantSecondary">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CDD5E2"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#2C3B52"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.participantAction">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#43546B"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.participantQuiet">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2563EB"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="64,*,66">
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#DDE3EC"
                BorderThickness="0,0,0,1">
            <Grid Margin="28,0" ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="SOCYVIA"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#273A69"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="SessionHeaderText"
                           Grid.Column="1"
                           FontSize="11"
                           Foreground="#59677B"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ProgressText"
                           Grid.Column="2"
                           FontSize="10"
                           Foreground="#718097"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="FeedScrollViewer"
                          IsVisible="False"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FeedPanel"
                            Width="700"
                            Margin="0,28,0,42"
                            Spacing="18"/>
            </ScrollViewer>

            <ScrollViewer x:Name="FocusedScrollViewer"
                          IsVisible="False"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="FocusedHost"
                                Width="720"
                                Margin="0,24,0,40"/>
            </ScrollViewer>

            <Border x:Name="StartPanel"
                    Width="520"
                    Padding="42"
                    Background="#FFFFFF"
                    BorderBrush="#DDE3EC"
                    BorderThickness="1"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="18">
                    <TextBlock x:Name="WelcomeTitle"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#1E304A"
                               TextAlignment="Center"/>
                    <TextBlock x:Name="WelcomeText"
                               FontSize="11"
                               Foreground="#647188"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                    <Border Padding="14,11" Background="#F4F7FA" CornerRadius="10">
                        <StackPanel Spacing="5">
                            <TextBlock x:Name="ParticipantIdentityText"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="#30445F" TextAlignment="Center"/>
                            <TextBlock x:Name="ConsentReadinessText"
                                       FontSize="8.5" Foreground="#587066"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <ContentControl x:Name="BeforeQuestionnaireStageHost" IsVisible="False"/>
                    <Button x:Name="StartButton"
                            Classes="participantPrimary"
                            HorizontalAlignment="Center"/>
                    <TextBlock x:Name="RuntimeErrorText"
                               IsVisible="False"
                               FontSize="10"
                               Foreground="#B8384F"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="PausePanel"
                    IsVisible="False"
                    Width="430"
                    Padding="36"
                    Background="#FFFFFF"
                    BorderBrush="#DDE3EC"
                    BorderThickness="1"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="PausedTitle"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1E304A"
                               TextAlignment="Center"/>
                    <TextBlock x:Name="PausedText"
                               FontSize="10"
                               Foreground="#647188"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                    <Button x:Name="ResumeButton"
                            Classes="participantPrimary"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ContentControl x:Name="AfterQuestionnaireStageHost" IsVisible="False"/>
        </Grid>

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#DDE3EC"
                BorderThickness="0,1,0,0">
            <Grid Margin="28,0" ColumnDefinitions="Auto,*,Auto">
                <Button x:Name="PauseButton"
                        Classes="participantSecondary"
                        IsVisible="False"
                        VerticalAlignment="Center"/>
                <TextBlock x:Name="PrivacyText"
                           Grid.Column="1"
                           FontSize="8.5"
                           Foreground="#8A95A6"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <Button x:Name="FinishButton"
                        Grid.Column="2"
                        Classes="participantPrimary"
                        IsVisible="False"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
