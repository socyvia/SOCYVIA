<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SOCYVIA.Views.GuidedDemoView"
             x:Name="RootDemo"
             FontFamily="{StaticResource EnglishFont}">
  <UserControl.Styles>
    <Style Selector="Button.demoStage">
      <Setter Property="Width" Value="178"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="#DCE4EF"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource SocyviaSecondaryTextBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="TextBlock.TextAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.demoStage:pointerover">
      <Setter Property="Background" Value="#0E2563EB"/>
      <Setter Property="Foreground" Value="{StaticResource SocyviaInkBrush}"/>
    </Style>
    <Style Selector="Button.demoStage.selected">
      <Setter Property="Background" Value="#142563EB"/>
      <Setter Property="BorderBrush" Value="{StaticResource SocyviaAccentBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
      <Setter Property="Foreground" Value="{StaticResource SocyviaAccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,18,*">
    <Grid x:Name="DemoHeroGrid" Grid.Row="0" ColumnDefinitions="*,24,Auto">
      <StackPanel x:Name="DemoHeadingPanel" Grid.Column="0" HorizontalAlignment="Stretch" Spacing="4">
        <TextBlock x:Name="DemoEyebrowText" Classes="eyebrow"/>
        <TextBlock x:Name="DemoTitleText" Classes="pageTitle" HorizontalAlignment="Stretch"/>
        <TextBlock x:Name="DemoSubtitleText" MaxWidth="720" FontSize="9.5" LineHeight="15"
                   Foreground="{StaticResource SocyviaSecondaryTextBrush}" TextWrapping="Wrap" HorizontalAlignment="Stretch"/>
      </StackPanel>
      <StackPanel x:Name="DemoBadgePanel" Grid.Column="2" Orientation="Horizontal"
                  Spacing="8" VerticalAlignment="Center">
        <Border Classes="badge info"><TextBlock x:Name="ReadOnlyText" FontSize="8" TextAlignment="Center"/></Border>
        <Border Classes="badge"><TextBlock x:Name="SyntheticText" FontSize="8" TextAlignment="Center"/></Border>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="210,18,*">
      <Border Grid.Column="0" Classes="commandSurface" Padding="14,16">
        <Grid RowDefinitions="Auto,12,*">
          <TextBlock x:Name="JourneyLabel" Classes="eyebrow" HorizontalAlignment="Center" TextAlignment="Center"/>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="StageNavigation" HorizontalAlignment="Center" Spacing="4">
              <Button x:Name="ContentStageButton" Classes="demoStage selected"/>
              <Button x:Name="DesignStageButton" Classes="demoStage"/>
              <Button x:Name="GroupsStageButton" Classes="demoStage"/>
              <Button x:Name="ConditionsStageButton" Classes="demoStage"/>
              <Button x:Name="ParticipantsStageButton" Classes="demoStage"/>
              <Button x:Name="ExperimentStageButton" Classes="demoStage"/>
              <Button x:Name="ExperienceStageButton" Classes="demoStage"/>
              <Button x:Name="QuestionnaireStageButton" Classes="demoStage"/>
              <Button x:Name="SessionsStageButton" Classes="demoStage"/>
              <Button x:Name="AnalysisStageButton" Classes="demoStage"/>
              <Button x:Name="ReportStageButton" Classes="demoStage"/>
              <Button x:Name="AiStageButton" Classes="demoStage"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="researchCard" Padding="26">
        <Grid RowDefinitions="Auto,16,*">
          <Grid x:Name="StageHeaderGrid" Grid.Row="0" ColumnDefinitions="*,16,Auto">
            <StackPanel x:Name="StageHeadingPanel" Grid.Column="0" HorizontalAlignment="Stretch" Spacing="4">
              <TextBlock x:Name="StageEyebrowText" Classes="eyebrow"/>
              <TextBlock x:Name="StageTitleText" FontSize="17" FontWeight="SemiBold"
                         Foreground="{StaticResource SocyviaInkBrush}" HorizontalAlignment="Stretch"/>
              <TextBlock x:Name="StageDescriptionText" MaxWidth="720" FontSize="9.2" LineHeight="15"
                         Foreground="{StaticResource SocyviaSecondaryTextBrush}" TextWrapping="Wrap" HorizontalAlignment="Stretch"/>
            </StackPanel>
            <Button x:Name="PreviewButton" Grid.Column="2" Classes="primary compact"
                    MinWidth="150" IsVisible="False" VerticalAlignment="Center">
              <TextBlock x:Name="PreviewButtonText" TextAlignment="Center"/>
            </Button>
          </Grid>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="StageContent"/>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
